# Copy this file to .env and fill in real values for your environment.
# Every variable here is optional.

# Canonical site URL, used for the <link rel="canonical"> tag and Open Graph metadata.
# Falls back to a placeholder (facefusion.example) until a real domain is set here.
VITE_SITE_URL=

# The real installer URL for the /download page's download button. Leave unset
# until an actual installer exists — the button renders disabled rather than
# pointing at an invented link.
VITE_DOWNLOAD_URL=
